rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Companies y todo lo que cuelga de ellas (members, roles, subcolecciones de negocio)
    match /companies/{companyId} {
      allow read, write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Settings globales (categories, roles legados, departments)
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // LLM rate-limits: solo Admin SDK desde Cloud Functions
    match /system/llm-rate-limits/{document=**} {
      allow read, write: if false;
    }

    // Wave 2.3 — progreso incremental de tools largas. El cliente lee
    // pasos en vivo via onSnapshot mientras la tool corre. Escrituras
    // tanto desde Cloud Functions (Admin SDK las salta) como desde el
    // cliente (executeMutation reporta pasos para tools client-side).
    // Datos efímeros, no sensibles. TTL de 24h se configura desde la
    // consola de Firestore sobre el campo `updatedAt`.
    match /toolProgress/{toolCallId} {
      allow read, write: if request.auth != null;
    }
  }
}
