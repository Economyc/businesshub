rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Companies y todo lo que cuelga de ellas (members, roles, subcolecciones de negocio)
    // Wave 4.2 — `companies/{companyId}/threads/{threadId}` queda cubierto por
    // el wildcard de subcolecciones de abajo: lectura/escritura para cualquier
    // miembro autenticado. Si más adelante endurecemos el RBAC, agregar regla
    // explícita por threads validando role del usuario en members/.
    match /companies/{companyId} {
      allow read, write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Settings globales (categories, roles legados, departments)
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    // Catálogo de proveedores compartido entre todas las companies.
    // Vive en la raíz (no bajo companies/) porque los mismos proveedores se
    // repiten entre locales. Acceso para cualquier usuario autenticado, igual
    // que las subcolecciones de negocio.
    match /suppliers/{supplierId} {
      allow read, write: if request.auth != null;
    }

    // Catálogo de tipos de novedad de Horarios compartido entre todas las
    // companies. Vive en la raíz (no bajo companies/) porque el catálogo es el
    // mismo para todos los locales — el Owner lo define una vez. Las novedades
    // aplicadas a la grilla siguen scopeadas bajo companies/{id}/novelties.
    match /noveltyTypes/{typeId} {
      allow read, write: if request.auth != null;
    }

    // LLM rate-limits: solo Admin SDK desde Cloud Functions
    match /system/llm-rate-limits/{document=**} {
      allow read, write: if false;
    }

    // Wave 1.2 — Memoria persistente del asistente AI por usuario.
    // Sólo el dueño (uid match) puede leer y escribir su propia memoria.
    match /users/{userId}/agentMemory/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tareas personales del usuario (módulo Tasks).
    // Cross-company por diseño: viven bajo /users/{uid} para no scopearse
    // por compañía. Sólo el dueño puede leer y escribir.
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Wave 2.3 — progreso incremental de tools largas. El cliente lee
    // pasos en vivo via onSnapshot mientras la tool corre. Escrituras
    // tanto desde Cloud Functions (Admin SDK las salta) como desde el
    // cliente (executeMutation reporta pasos para tools client-side).
    // Datos efímeros, no sensibles. TTL de 24h se configura desde la
    // consola de Firestore sobre el campo `updatedAt`.
    match /toolProgress/{toolCallId} {
      allow read, write: if request.auth != null;
    }
  }
}
