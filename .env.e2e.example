# Copia este archivo a .env.e2e y completa las credenciales del usuario tester.
# .env.e2e está gitignoreado.
E2E_USER=
E2E_PASS=

# Opcional: apuntar los tests a otro entorno (por defecto https://businesshub.myvnc.com)
# E2E_BASE_URL=http://localhost:5173

# Opcional: poner en 1 para incluir el test que CREA datos reales en producción.
# E2E_WRITE=1
