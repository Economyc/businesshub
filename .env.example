# Variables de entorno requeridas por el frontend (App1 BusinessHub + App2 admin).
# Vite inlinea estas VITE_FIREBASE_* EN BUILD. Sin ellas, el bundle arranca con
# `apiKey: void 0` → Firebase lanza `auth/invalid-api-key` y la app queda en
# pantalla blanca. El build (`npm run build`) ahora ABORTA si falta alguna.
#
# Uso: copia este archivo a `.env.local` (gitignoreado) y rellena los valores
# reales desde Firebase Console → Project settings → empresas-bf.
# En App2 (Coolify/Hetzner) estas se definen como Environment Variables marcadas
# "Build" (ver Dockerfile.admin).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
